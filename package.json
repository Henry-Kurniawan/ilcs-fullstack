{
  "name": "musicpedia",
  "private": true,
  "type": "module",
  "workspaces": ["shared", "backend", "frontend"],
  "engines": { "node": ">=22.18" },
  "scripts": {
    "db:up": "docker compose up -d --wait db",
    "migrate": "npm run migrate --workspace backend",
    "dev": "npm run db:up && npm run migrate && concurrently -n backend,frontend -c blue,green \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run typecheck && npm run db:up && vitest run",
    "build": "npm run build -w frontend"
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
