DATABASE_URL=postgres://musicpedia:musicpedia@localhost:5433/musicpedia
PORT=3000
NODE_ENV=development
# Wajib diisi di produksi. Nilai contoh hanya untuk pengembangan.
SESSION_SECRET=ganti-dengan-rahasia-panjang-acak
# Akun Admin dibuat hanya lewat `npm run seed`.
ADMIN_EMAIL=admin@musicpedia.id
ADMIN_PASSWORD=admin12345
# Direktori penyimpanan mp3 dan Trial, di luar web root.
AUDIO_DIR=./audio
# Binari ffmpeg. Di mesin ini bisa diarahkan ke build statis, misalnya
# /home/adity/workspace/ilcs-fullstack/.tools/ffmpeg.
FFMPEG_PATH=ffmpeg
