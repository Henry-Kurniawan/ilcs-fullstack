DATABASE_URL=postgres://musicpedia:musicpedia@localhost:5433/musicpedia
PORT=3000
NODE_ENV=development
# Wajib diisi di produksi (minimal 32 karakter). Nilai contoh hanya untuk pengembangan.
SESSION_SECRET=wDqJ9S2Ek8Tn3QPzHTJnYheNovHwRiPr1oz3iXl2jzU=
# Akun Admin dibuat hanya lewat `npm run seed`.
ADMIN_EMAIL=admin@musicpedia.id
ADMIN_PASSWORD=admin12345
# Direktori penyimpanan mp3 dan Trial, di luar web root.
AUDIO_DIR=./audio
# Binari ffmpeg. Di mesin ini bisa diarahkan ke build statis, misalnya
# /home/adity/workspace/ilcs-fullstack/.tools/ffmpeg. Container pengembangan
# memakai /usr/bin/ffmpeg dari image, jadi nilai ini hanya untuk dev:local.
FFMPEG_PATH=ffmpeg
# Midtrans. Server key hanya dipakai backend dan tidak pernah dikirim ke browser.
#MIDTRANS_SERVER_KEY=SB-Mid-server-LvwC~zvZtsYva_UkEG3A2Opo
MIDTRANS_SERVER_KEY=
# Client key bersifat publik; frontend mengambilnya lewat GET /api/konfigurasi
# untuk memuat snap.js. Tidak perlu variabel VITE_.
#MIDTRANS_CLIENT_KEY=Mid-client-NphNqwFE-eUSOjlv
MIDTRANS_CLIENT_KEY=
# true memakai Midtrans produksi; false memakai sandbox.
MIDTRANS_PRODUCTION=false

# --- Produksi ---
# File ini untuk pengembangan. Untuk Docker Compose produksi, salin
# .env.production.example menjadi .env.production lalu isi secret di server.
# Script backup/restore membaca variabel berikut.
BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=14
# Kosongkan untuk backup lokal saja; isi remote rclone untuk off-site.
BACKUP_RCLONE_REMOTE=
